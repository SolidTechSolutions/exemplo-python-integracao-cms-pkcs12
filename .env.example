# [EN]    Base URL of the SolidSign API (without trailing slash)
# [PT-BR] URL base da API SolidSign (sem barra no final)
SOLIDSIGN_API_BASE_URL=http://localhost:8080

# [EN]    Authorization header value — include "Bearer " prefix
# [PT-BR] Valor do header Authorization — inclua o prefixo "Bearer "
SOLIDSIGN_API_AUTHORIZATION=Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJrZXkucnVkaW1hcjUxOTEuYXBwbGljYXRpb24uNSIsImFwcE5hbWUiOiJUZXN0ZSA0IiwidXNlck5hbWUiOiJydWRpbWFyNTE5MSIsImlzcyI6InNvbGlkc2lnbi5jb20uYnIvc29saWRzaWduL2F1dGgvcHVibGljLWtleSIsImlhdCI6MTc4MjkzODI3OCwiZXhwIjoxNzgyOTQxODc4fQ.AMsYyo7AlehZ-UBGZeSAVgdf_6yPGniGRORYEqnOEujRrMyMYbeAkqI64EZQfXRXUJQrBdwJC3sRQnGA-wsW_TLqJd-TTxHzfanpb-cP5DZGNJELS6p9NOshu_xCCWhGh7LRm3M7yDuyu3UAv54BTBsG3dVvmqt1LAI19098gEVIbKw5ExZbp-RINjT68qoclOqqK3NCaFUCe4Zn7XioOkmyBQ3VQ2LugEXStbEQ_c1h4CuLZPApuikMfJT4OqvwCA-cKsD4jTHLvR2rr4xeDbkyiwV3MbSnl42siTjuSYjjJ2FQdUrMj2KYuywgo0O3I3M5IdmRgHwhp6loqkOg6w

# [EN]    UUID of the PKCS#12 certificate previously imported via:
#         POST /solidsign/dsig/certificates/pkcs12/import
# [PT-BR] UUID do certificado PKCS#12 previamente importado via:
#         POST /solidsign/dsig/certificates/pkcs12/import
SOLIDSIGN_CERT_ID=ef7cdc0e-abf8-4937-8c19-ed8ef6fab8c0

# [EN]    Input folder — files of any type will be processed
# [PT-BR] Pasta de entrada — arquivos de qualquer tipo serão processados
SOLIDSIGN_BATCH_INPUT_PATH=C:/input_files

# [EN]    Output folder where the signed ZIP will be saved
# [PT-BR] Pasta de saída onde o ZIP assinado será salvo
SOLIDSIGN_BATCH_OUTPUT_PATH=C:/signed_results

# [EN]    Signature profile: CADES_B, CADES_T, CADES_LT, CADES_LTA, ADRB, ADRT, ADRC, ADRA
# [PT-BR] Perfil de assinatura: CADES_B, CADES_T, CADES_LT, CADES_LTA, ADRB, ADRT, ADRC, ADRA
SOLIDSIGN_SIG_PROFILE=ADRA

# [EN]    Hash algorithm (SHA256, SHA384, SHA512)
# [PT-BR] Algoritmo de hash (SHA256, SHA384, SHA512)
SOLIDSIGN_SIG_HASH_ALGORITHM=SHA256

# [EN]    Signature packaging (ENVELOPING, ENVELOPED, DETACHED)
# [PT-BR] Empacotamento da assinatura (ENVELOPING, ENVELOPED, DETACHED)
SOLIDSIGN_SIG_PACKAGING=ENVELOPING

# [EN]    Optional: policy version — leave blank to use the API default
# [PT-BR] Opcional: versão da política — deixe em branco para usar o padrão da API
SOLIDSIGN_SIG_POLICY_VERSION=
